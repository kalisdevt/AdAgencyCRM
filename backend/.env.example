# Скопируйте в .env и при необходимости измените значения.
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Секрет подписи JWT. В production обязателен.
JWT_SECRET=change-me

# Разрешенный источник для веб-интерфейса (CORS).
CORS_ORIGIN=http://localhost:5173

# Telegram-бот (необязательно). Без токена прием и ответы в Telegram отключены.
TELEGRAM_BOT_TOKEN=
# true — получать сообщения длинным опросом (удобно локально, без публичного адреса).
TELEGRAM_POLLING=false
# Секрет, который Telegram передает в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=

# true — при старте создать демо-пользователей и тестовые обращения.
SEED_DEMO=false
# Пароль демо-пользователей (по умолчанию указан в README).
SEED_PASSWORD=
