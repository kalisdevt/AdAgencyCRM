# Скопируйте в .env и при необходимости измените значения.
PORT=3000
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Прямое соединение для миграций, если DATABASE_URL ведет через пул соединений (например, Neon).
# DATABASE_URL_UNPOOLED=

# Секрет подписи JWT. В production обязателен.
JWT_SECRET=change-me

# Разрешенный источник для веб-интерфейса (CORS).
CORS_ORIGIN=http://localhost:5173

# Хранилище файлов (макеты, счета): disk — каталог STORAGE_DIR, db — в PostgreSQL (для Vercel).
FILE_STORAGE=disk
STORAGE_DIR=storage
# Максимальный размер загружаемого файла, МБ.
MAX_UPLOAD_MB=10

# Telegram-бот (необязательно). Без токена прием и ответы в Telegram отключены.
TELEGRAM_BOT_TOKEN=
# true — получать сообщения длинным опросом (удобно локально, без публичного адреса).
TELEGRAM_POLLING=false
# Секрет, который Telegram передает в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=

# true — при старте создать демо-пользователей и тестовые обращения.
SEED_DEMO=false
# Пароль демо-пользователей (по умолчанию указан в README).
SEED_PASSWORD=

# Реквизиты агентства для счетов (по умолчанию — тестовые значения).
# AGENCY_NAME=
# AGENCY_INN=
# AGENCY_KPP=
# AGENCY_ADDRESS=
# AGENCY_BANK=
# AGENCY_BIK=
# AGENCY_ACCOUNT=
# AGENCY_CORR_ACCOUNT=
# AGENCY_DIRECTOR=
